# Noyola Hub - Environment Variables
# Copy to .env and fill in. .env is gitignored.

# Anthropic (Claude Sonnet 4.5 with Vision) - used by Spell Quest:
#   /api/extract-words  (photo of spelling list -> JSON word list)
#   /api/grade-spelling (handwriting canvases -> per-word correctness + feedback)
ANTHROPIC_API_KEY=

# Cartesia (Sonic-2 TTS) - used by Spell Quest:
#   /api/tts (runtime dictation of each word in The Keeper's voice)
CARTESIA_API_KEY=

# Optional: override the default "Keeper" voice.
# Defaults to Cartesia's "Carl - Steady Storyteller" (ed82c17b-4704-4d34-be43-5d19065acdf1).
CARTESIA_VOICE_ID=

# ---- AI asset-generation tools (dev only; not used by the deployed app) ----
GOOGLE_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
